# BLAXCY example configuration.
#
# Copy to `.env` (git-ignored) and fill in what you need. Real environment
# variables always win over this file. API keys are resolved from the OS
# credential store first, with these environment values as a fallback.

# --- safety ---------------------------------------------------------------
# Live mouse/keyboard control stays disabled until this is set to 1.
# BLAXCY_ENABLE_REAL_INPUT=0
# Highest action risk Policy will permit: low | medium | high
# BLAXCY_MAX_RISK=medium
# Planner backend: rules (deterministic, default) or model (validated)
# BLAXCY_PLANNER=rules

# --- runtime --------------------------------------------------------------
# Install/data directory. The launcher and credentials live here.
# BLAXCY_HOME=/home/you/.local/share/blaxcy
# Components to run as supervised processes: a comma list of eye,memory,brain
# or the word "all". Empty means fully in-process.
# BLAXCY_SPLIT=
# BLAXCY_FRAME_INTERVAL=0.4
# BLAXCY_PERSIST_FRAMES=0

# --- model providers (OpenAI-compatible) ----------------------------------
# Each provider takes BLAXCY_<PROVIDER>_API_KEY / _BASE_URL / _MODEL.
# BLAXCY_OPENAI_API_KEY=sk-...
# BLAXCY_OPENAI_BASE_URL=https://api.openai.com/v1
# BLAXCY_OPENAI_MODEL=gpt-4o-mini
# BLAXCY_GROQ_API_KEY=
# BLAXCY_OPENROUTER_API_KEY=
# BLAXCY_TOGETHER_API_KEY=
# BLAXCY_ANTHROPIC_API_KEY=

# --- local model (Ollama-compatible) --------------------------------------
# BLAXCY_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# BLAXCY_LOCAL_MODEL=local-model
